{
  "version": 2,
  "builds": [
    {
      "src": "client/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/client/index.html"
    },
    {
      "src": "^/(?!api/)(.*)$",
      "dest": "/client/$1"
    }
  ]
}
